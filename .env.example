# ============================================================================
# mtracker - Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for local development:
#   cp .env.example .env
#
# `.env` is loaded automatically on startup via `spring.config.import` in
# application.yaml (optional:file:.env[.properties]) - no extra tooling needed,
# just run `./gradlew bootRun` (or launch the app from the IDE) with a `.env`
# file present in the project root.
# ============================================================================

# MongoDB. MONGODB_DATABASE wins over whatever database is in MONGODB_URI's path.
MONGODB_URI=mongodb://localhost:27017/mtracker_db
MONGODB_DATABASE=mtracker_db

# Raider.IO region for every tracked guild/player (single-region deployment for now).
MTRACKER_REGION=eu

# NOTE: which guilds/players get tracked is NOT configured here anymore - it's managed at
# runtime via MongoDB (TrackedGuild/TrackedPlayer) through the /api/v1/admin/** CRUD API
# (see MTRACKER_ADMIN_TOKEN below and README.md).

# Sync scheduling
MTRACKER_SYNC_INTERVAL_HOURS=6
MTRACKER_SYNC_REQUEST_DELAY_MS=250

# Raider.IO API base URL (rarely needs overriding)
RAIDERIO_BASE_URL=https://raider.io/api/v1

# Shared secret for S2S callers (e.g. tg-bot). Leave blank to keep /api/v1/s2s/** closed.
MTRACKER_S2S_TOKEN=

# Shared secret for the /api/v1/admin/** CRUD API (managing tracked guilds/players).
# Leave blank to keep /api/v1/admin/** closed.
MTRACKER_ADMIN_TOKEN=

# Logging
LOG_LEVEL_MTRACKER=INFO
LOG_LEVEL_MONGO_DRIVER=WARN

# Misc
SERVER_PORT=8080
